<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <View
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_day_work" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ShiftCalendar"
        android:textColor="@color/text_dark"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Ваши рабочие и выходные дни — всегда перед глазами"
        android:textColor="@color/text_muted"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Выберите график: 5/2, 2/2, 3/3, 6/1 или свой"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Календарь сам раскрасит рабочие и выходные дни"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Добавляйте заметки к дням и следите за статистикой"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_btn_sandy"
        android:gravity="center"
        android:text="Начать"
        android:textColor="@color/text_dark"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>