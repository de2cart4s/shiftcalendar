<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_warm"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/sheet_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheet_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_work"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_work"
            android:gravity="center"
            android:text="Рабочий"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_off"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_off"
            android:gravity="center"
            android:text="Выходной"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_hours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/sheet_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Заметка к дню"
        android:inputType="text"
        android:textColor="@color/text_dark"
        android:textColorHint="@color/text_muted" />

    <TextView
        android:id="@+id/sheet_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_sandy"
        android:gravity="center"
        android:text="Сохранить изменения"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>